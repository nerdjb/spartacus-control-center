# udev rules for DeepCool Spartacus Control Center
# Grants unprivileged user access to DeepCool Spartacus USB devices
# 
# Place in /etc/udev/rules.d/99-spartacus.rules or use PKGBUILD to install
# After installation, reload rules: sudo udevadm control --reload

# DeepCool Spartacus LCD Display Device (USB VID:PID 3633:0027)
# Allows user to read/write to LCD display interface
SUBSYSTEMS=="usb", ATTRS{idVendor}=="3633", ATTRS{idProduct}=="0027", MODE="0666", TAG="uaccess"

# DeepCool Spartacus Linker Controller (USB VID:PID 3633:002d)
# Handles pump RPM, radiator fan RPM, auxiliary fans, ARGB, watchdog
# NOTE: idProduct must be lowercase - sysfs reports hex in lowercase and
# udev matching is case-sensitive.
SUBSYSTEMS=="usb", ATTRS{idVendor}=="3633", ATTRS{idProduct}=="002d", MODE="0666", TAG="uaccess"

# Allow hidraw access for both devices
KERNEL=="hidraw*", ATTRS{idVendor}=="3633", ATTRS{idProduct}=="0027", MODE="0666", TAG="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="3633", ATTRS{idProduct}=="002d", MODE="0666", TAG="uaccess"

# Reload udev rules after installation
# udevadm control --reload
# udevadm trigger --attr-match=idVendor=3633
